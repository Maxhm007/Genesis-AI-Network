{
  "version": 1,
  "modules": [
    {
      "module_id": "genesis.evaluation",
      "name": "Evaluation Module",
      "version": "0.1.1",
      "purpose": "Provide evidence-first benchmark and capability evaluation where unmeasured capability receives zero credit.",
      "capabilities": ["benchmark_evaluation", "capability_evidence", "regression_measurement"],
      "permissions": ["benchmarks.read", "evidence.read", "scores.write_candidate"],
      "dependencies": ["genesis.validation"],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.evaluation",
      "metadata": {"architecture_credit_without_evidence": false, "foundation_implemented": true}
    },
    {
      "module_id": "genesis.experiment",
      "name": "Experiment Module",
      "version": "0.1.1",
      "purpose": "Run bounded baseline-versus-candidate comparisons so Genesis keeps improvements only when measured evidence supports them.",
      "capabilities": ["controlled_experiments", "baseline_comparison", "candidate_keep_reject"],
      "permissions": ["benchmarks.read", "tasks.read", "evidence.write_candidate"],
      "dependencies": ["genesis.evaluation", "genesis.validation"],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.experiment",
      "metadata": {"automatic_promotion": false, "foundation_implemented": true}
    },
    {
      "module_id": "genesis.resource",
      "name": "Resource Module",
      "version": "0.1.1",
      "purpose": "Represent CPU, memory, disk, battery and network capacity for resource-aware routing and scheduling.",
      "capabilities": ["resource_telemetry", "capacity_scoring", "resource_aware_routing"],
      "permissions": ["system.telemetry.read"],
      "dependencies": ["genesis.router", "genesis.efficiency"],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.resource",
      "metadata": {"telemetry_only": true, "foundation_implemented": true}
    },
    {
      "module_id": "genesis.model_scout",
      "name": "Model Scout Module",
      "version": "0.1.1",
      "purpose": "Discover and advance model/provider candidates through a sequential trust lifecycle using license, benchmark and resource evidence.",
      "capabilities": ["model_discovery", "provider_scouting", "model_trust_lifecycle", "model_benchmark_selection"],
      "permissions": ["providers.discover", "benchmarks.read", "evidence.read", "tasks.write"],
      "dependencies": ["genesis.evaluation", "genesis.resource", "genesis.validation"],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.model_scout",
      "metadata": {"automatic_activation": false, "trust_lifecycle": ["discovered", "quarantined", "tested", "validated", "trusted", "active"], "foundation_implemented": true}
    },
    {
      "module_id": "genesis.evidence",
      "name": "Evidence Module",
      "version": "0.1.1",
      "purpose": "Represent scientific and system claims with source, provenance, confidence and explicit candidate/review/validation states.",
      "capabilities": ["evidence_records", "claim_provenance", "evidence_validation", "contradiction_tracking"],
      "permissions": ["knowledge.read", "evidence.write_candidate", "evidence.write_reviewed", "evidence.write_validated"],
      "dependencies": ["genesis.knowledge", "genesis.validation"],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.evidence",
      "metadata": {"candidate_is_not_truth": true, "foundation_implemented": true}
    },
    {
      "module_id": "genesis.peer_compute",
      "name": "Peer Compute Module",
      "version": "0.1.1",
      "purpose": "Provide bounded GDEN task leases and content-hash verification primitives for future distributed computation.",
      "capabilities": ["peer_work_leasing", "distributed_compute", "result_hash_verification"],
      "permissions": ["gden.peers.read", "tasks.read", "tasks.write_result_candidate"],
      "dependencies": ["genesis.gden", "genesis.resource", "genesis.validation"],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.peer_compute",
      "metadata": {"remote_result_trusted_by_default": false, "max_lease_seconds": 3600, "foundation_implemented": true}
    }
  ]
}
