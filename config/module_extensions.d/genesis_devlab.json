{
  "modules": [
    {
      "module_id": "genesis.devlab",
      "name": "Genesis DevLab",
      "version": "0.2.0",
      "purpose": "Provide a bounded autonomous development workbench for isolated code inspection, experimentation, Code - OSS editing sessions, testing, retry planning, candidate preparation, and validation feedback.",
      "capabilities": [
        "development_workspace",
        "code_inspection",
        "isolated_editing",
        "code_oss_workspace",
        "ide_session",
        "test_execution",
        "failure_feedback",
        "retry_planning",
        "candidate_preparation"
      ],
      "permissions": [
        "code.read",
        "code.write_candidate",
        "tests.run",
        "audit.read",
        "provider.use"
      ],
      "dependencies": [
        "genesis.engineering",
        "genesis.self_development",
        "genesis.security",
        "genesis.validation"
      ],
      "status": "active",
      "dynamic": false,
      "mutable": true,
      "protected": false,
      "implementation": "genesis.devlab",
      "metadata": {
        "aliases": [],
        "components": [
          "genesis.devlab.workspace",
          "genesis.devlab.inspection",
          "genesis.devlab.module",
          "genesis.devlab.code_oss"
        ],
        "direct_main_write": false,
        "validation_authority": false,
        "protected_file_bypass": false,
        "code_oss": {
          "role": "isolated_ide_workspace",
          "submodule_path": "vendor/code-oss",
          "upstream": "https://github.com/microsoft/vscode.git",
          "candidate_import_only": true,
          "canonical_workspace_write": false,
          "promotion_requires_existing_validation_pipeline": true
        }
      }
    }
  ]
}
