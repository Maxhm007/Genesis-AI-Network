[Unit]
Description=Genesis Gene continuous worker (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gene
Group=gene
WorkingDirectory=/opt/genesis
Environment=PYTHONUNBUFFERED=1
Environment=GITHUB_REPOSITORY=Maxhm007/Genesis-AI-Network
EnvironmentFile=-/etc/genesis/github.env
ExecStart=/opt/genesis/.venv/bin/python -m scripts.gene_issue_continuous --gene %i --idle-pause 5 --authority-retry-pause 60
Restart=always
RestartSec=3
StartLimitIntervalSec=0
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/genesis/runtime /opt/genesis/.git

[Install]
WantedBy=multi-user.target
